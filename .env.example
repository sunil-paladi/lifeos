# PostgreSQL database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Prisma shadow database
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/SHADOW_DATABASE"

# Better Auth
BETTER_AUTH_SECRET="generate-a-secure-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Groq AI workout generation
GROQ_API_KEY=""
# Default: openai/gpt-oss-20b (documented by Groq for structured outputs).
GROQ_MODEL="openai/gpt-oss-20b"

# Password reset email delivery (Resend)
RESEND_API_KEY=""
EMAIL_FROM=""
